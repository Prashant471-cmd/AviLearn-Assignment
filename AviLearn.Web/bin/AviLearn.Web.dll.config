<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <connectionStrings>
    <!-- Change this to match your local SQL Server instance (e.g., .\SQLEXPRESS) -->
    <add name="AviLearnDB" connectionString="Server=(localdb)\MSSQLLocalDB;Database=avilearn;Trusted_Connection=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    
    <!-- Forms Authentication Configuration -->
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="2880" defaultUrl="~/Dashboard.aspx" />
    </authentication>
    
    <!-- Custom Errors -->
    <customErrors mode="Off" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>

  <!-- Authorization rules for Admin folder -->
  <location path="Admin">
    <system.web>
      <authorization>
        <!-- Deny anonymous users; Role checking is handled in Page_Load of admin pages -->
        <deny users="?" />
      </authorization>
    </system.web>
  </location>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
    </assemblyBinding>
  </runtime>
</configuration>
