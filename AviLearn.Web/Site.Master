<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.Master.cs" Inherits="AviLearn.Web.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - AviLearn</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;800;900&display=swap" rel="stylesheet" />

    <link href="~/styles/avilearn.css?v=4" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server" class="main-canvas">
        <header class="site-header">
            <a href="Default.aspx" class="brand">
                <div class="brand-icon"></div>
                <span class="brand-text">AviLearn</span>
            </a>
            
            <nav class="nav-center">
                <a href="Default.aspx" class='<%= Request.Url.AbsolutePath.EndsWith("Default.aspx", StringComparison.OrdinalIgnoreCase) || Request.Url.AbsolutePath.EndsWith("/") ? "active" : "" %>'>Discover</a>
                <a href="BirdDirectory.aspx" class='<%= Request.Url.AbsolutePath.EndsWith("BirdDirectory.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>'>Species</a>
                
                <% if (Session["UserRole"] != null) { %>
                    <a href="Dashboard.aspx" class='<%= Request.Url.AbsolutePath.EndsWith("Dashboard.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>'>Dashboard</a>
                    <a href="Quiz.aspx" class='<%= Request.Url.AbsolutePath.EndsWith("Quiz.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>'>Quizzes</a>
                    <% if (Session["UserRole"].ToString() == "admin") { %>
                        <a href="Admin/Default.aspx" style="color: #EF4444;" class='<%= Request.Url.AbsolutePath.EndsWith("Admin/Default.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>'>Admin</a>
                    <% } %>
                <% } else { %>
                    <a href="About.aspx" class='<%= Request.Url.AbsolutePath.EndsWith("About.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>'>About</a>
                <% } %>
            </nav>

            <div class="header-right">
                <div class="search-bar">
                    <input type="text" placeholder="Search..." />
                </div>
                
                <div class="user-actions">
                    <% if (Session["UserRole"] == null) { %>
                        <a href="Login.aspx">Login</a>
                    <% } else { %>
                        <a href="Profile.aspx" style="margin-right: 15px; font-weight: 700; color: var(--accent);">My Profile</a>
                        <asp:Button ID="btnLogout" runat="server" Text="Logout" CssClass="btn-logout" OnClick="btnLogout_Click" CausesValidation="false" />
                    <% } %>
                </div>
            </div>
        </header>

        <main id="main-content" role="main" style="flex: 1; display: flex; flex-direction: column;">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const mainContent = document.getElementById("main-content");
                if (mainContent) {
                    // Trigger entrance animation
                    mainContent.classList.add("page-transition");
                }

                document.querySelectorAll('a').forEach(anchor => {
                    anchor.addEventListener('click', function (e) {
                        const targetUrl = this.getAttribute('href');
                        
                        // Ignore buttons, hashes, empty links, new tabs, modifiers, or external links
                        if (!targetUrl || 
                            targetUrl.startsWith('#') || 
                            targetUrl.startsWith('javascript:') || 
                            this.target === '_blank' || 
                            e.ctrlKey || e.metaKey || 
                            this.hostname !== window.location.hostname) {
                            return;
                        }

                        // Prevent default navigation to trigger fade out first
                        e.preventDefault();
                        if (mainContent) {
                            mainContent.classList.add("fade-out");
                        }
                        
                        // Wait for animation, then navigate
                        setTimeout(() => {
                            window.location.href = this.href;
                        }, 300); // 300ms matches fadeOutSlideDown duration
                    });
                });
            });
        </script>
    </form>
</body>
</html>
