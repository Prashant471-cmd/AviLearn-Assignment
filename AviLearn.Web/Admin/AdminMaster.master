<%@ Master Language="C#" AutoEventWireup="true" CodeFile="AdminMaster.master.cs" Inherits="AviLearn.Web.Admin.AdminMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Admin - AviLearn</title>
    
    <link href="~/styles/avilearn.css" rel="stylesheet" type="text/css" />

    <style>
        .admin-layout {
            display: flex;
            min-height: 100vh;
            background-color: var(--color-bg-alt);
        }
        
        .admin-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 260px;
            height: 100vh;
            background-color: var(--color-bg-canvas);
            border-right: 1px solid var(--color-border);
            padding: 2.5rem 1.5rem;
            display: flex;
            flex-direction: column;
            z-index: 20;
            overflow-y: auto;
        }
        
        .admin-sidebar h2 {
            font-size: 1.75rem;
            font-weight: 900;
            color: var(--color-text-primary);
            margin-bottom: 3rem;
            padding-left: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .admin-sidebar h2::before {
            content: '';
            display: block;
            width: 16px;
            height: 16px;
            background-color: var(--color-accent);
            border-radius: 4px;
        }
        
        .admin-sidebar nav {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .admin-sidebar a {
            color: var(--color-text-muted);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 1rem 1.25rem;
            border-radius: var(--radius-md);
            font-size: 1rem;
            font-weight: 700;
            transition: all 0.2s ease;
        }
        
        .admin-sidebar a svg {
            width: 20px;
            height: 20px;
            stroke-width: 2.5;
            flex-shrink: 0;
        }
        
        .admin-sidebar a:hover {
            background-color: var(--color-bg-alt);
            color: var(--color-nav-active);
            transform: translateX(4px);
        }
        
        .admin-sidebar a.exit-link {
            margin-top: auto;
            color: #EF4444;
            background-color: #FEF2F2;
        }
        
        .admin-sidebar a.exit-link:hover {
            background-color: #FEE2E2;
            color: #DC2626;
        }

        .admin-main {
            margin-left: 260px;
            flex: 1;
            padding: 3rem 4rem;
            position: relative;
            z-index: 10;
        }

        .admin-main::before {
            content: '';
            position: fixed;
            top: 0;
            left: 260px;
            width: calc(100% - 260px);
            height: 100%;
            background-image: url('/images/dashboard_bg_circles.png');
            background-position: center;
            background-repeat: no-repeat;
            background-size: cover;
            opacity: 0.3;
            z-index: -1;
            pointer-events: none;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
            padding-bottom: 1.5rem;
            border-bottom: 2px solid var(--color-border);
        }
        
        .admin-header h1 {
            font-size: 2.25rem;
            font-weight: 900;
            color: var(--color-text-primary);
            margin: 0;
        }
        
        .admin-user-badge {
            background: white;
            padding: 0.5rem 1.25rem;
            border-radius: var(--radius-pill);
            border: 1px solid var(--color-border);
            font-weight: 700;
            color: var(--color-nav-active);
            box-shadow: var(--shadow-sm);
        }
        
        /* Global Admin Card Styles */
        .admin-card {
            background: white;
            border-radius: var(--radius-xl);
            padding: 2.5rem;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--color-border);
        }
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="admin-layout">
            <aside class="admin-sidebar">
                <h2>AviLearn</h2>
                <nav>
                    <a href="Default.aspx">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                        Activity Overview
                    </a>
                    <a href="BirdSpecies.aspx">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path></svg>
                        Bird Species
                    </a>
                    <a href="Users.aspx">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        User Accounts
                    </a>
                </nav>
                <a href="../Default.aspx" class="exit-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    Exit to Public Site
                </a>
            </aside>
            
            <main class="admin-main">
                <header class="admin-header">
                    <h1><%: Page.Title %></h1>
                    <span class="admin-user-badge">
                        Admin: <%: Session["UserName"] %>
                    </span>
                </header>
                
                <div class="admin-content-wrapper">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
                </div>
            </main>
        </div>
    </form>
</body>
</html>
